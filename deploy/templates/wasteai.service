# File: deploy/templates/wasteai.service
[Unit]
Description=AI Waste Segregation API (wasteai)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=__APP__/server
EnvironmentFile=__APP__/server/.env
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONUTF8=1"
ExecStart=__APP__/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port __PORT__ --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
# Estimates, tuned from measurements in A7
MemoryHigh=350M
MemoryMax=450M
OOMScoreAdjust=0
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
